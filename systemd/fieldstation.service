[Unit]
Description=FieldStation local operator app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshmon
Group=meshmon
SupplementaryGroups=dialout tty
Environment=FIELDSTATION_ROOT=/opt/meshmon-companion
Environment=FIELDSTATION_CONFIG=/etc/meshmon-companion/config.yaml
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/fieldstation
WorkingDirectory=/opt/meshmon-companion
ExecStart=/opt/meshmon-companion/.venv-fieldstation/bin/python /opt/meshmon-companion/fieldstation/server.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/meshmon-companion /etc/meshmon-companion

[Install]
WantedBy=multi-user.target
