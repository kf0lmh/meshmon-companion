services:
  serial-bridge:
    image: ${SERIAL_BRIDGE_IMAGE}
    container_name: meshmon-serial-bridge
    devices:
      - ${SERIAL_DEVICE}:/dev/ttyACM0
    expose:
      - "4403"
    environment:
      SERIAL_DEVICE: /dev/ttyACM0
      BAUD_RATE: ${SERIAL_BAUD}
      TCP_PORT: 4403
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

  meshmonitor:
    image: ${MESHMONITOR_IMAGE}
    container_name: meshmonitor
    ports:
${MESHMONITOR_PORT_BINDINGS}
    volumes:
      - /opt/meshmon-companion/data/meshmonitor:/data
    environment:
      MESHTASTIC_NODE_IP: serial-bridge
      MESHTASTIC_TCP_PORT: 4403
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS}
    restart: unless-stopped
    depends_on:
      - serial-bridge
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
